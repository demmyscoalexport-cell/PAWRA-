  "typography": {
    "fonts": {
      "serif": { "family": "Playfair Display", "fallbacks": ["Georgia", "serif"], "weights": [400, 500, 600, 700], "italicWeights": [400] },
      "sans": { "family": "Inter", "fallbacks": ["system-ui", "sans-serif"], "weights": [400, 500, 600, 700] },
      "mono": { "family": "JetBrains Mono", "fallbacks": ["ui-monospace", "monospace"], "weights": [400, 500] }
    },
    "googleFontsUrl": "https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap",
    "rules": {
      "h1h2h3": "serif",
      "uiBodyButtonsNav": "sans",
      "codesStatsCopyright": "mono",
      "antialiased": true
    },
    "scale": {
      "display-xl": { "size": "4.5rem", "lineHeight": "5rem", "letterSpacing": "-0.02em", "fontWeight": "500", "family": "serif" },
      "display-l": { "size": "3.5rem", "lineHeight": "4rem", "letterSpacing": "-0.02em", "fontWeight": "500", "family": "serif" },
      "display-m": { "size": "2.5rem", "lineHeight": "3rem", "letterSpacing": "-0.02em", "fontWeight": "500", "family": "serif" },
      "display-s": { "size": "2rem", "lineHeight": "2.5rem", "letterSpacing": "-0.02em", "fontWeight": "500", "family": "serif" },
