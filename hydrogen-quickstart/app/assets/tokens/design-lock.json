  "philosophy": {
    "lightThemeName": "Trust & Warmth",
    "darkThemeName": "Sleek & Cozy",
    "principles": [
      "Enterprise calm — minimal elevation, soft borders, no neon or purple glow",
      "Brand-first full-bleed heroes — logo, one headline, one support line, one CTA group",
      "No hero overlays (badges, chips, promo stickers)",
      "Light: chestnut-tinted shadows; Dark: borders only, no shadows",
      "Serif for display; sans for UI; mono for codes/stats/copyright",
      "Motion for presence — short reveals, hover scale 1.02, honor reduced motion"
    ],
    "forbidden": [
      "purple-on-white / purple-to-indigo gradients",
      "pure black #000000 surfaces",
      "neon jade #2EE8A0",
      "champagne #C9A96E as brand accent",
      "coral #FF6B5B as sale accent",
      "heavy multi-layer drop shadows",
      "glow stacks / glassmorphism as default"
    ]
  },
