      "heading-xs": { "size": "1rem", "lineHeight": "1.5rem", "fontWeight": "500", "family": "sans" },
      "body-xl": { "size": "1.125rem", "lineHeight": "1.75rem", "fontWeight": "400", "family": "sans" },
      "body-l": { "size": "1.125rem", "lineHeight": "1.75rem", "fontWeight": "400", "family": "sans" },
      "body-m": { "size": "1rem", "lineHeight": "1.5rem", "fontWeight": "400", "family": "sans" },
      "body-s": { "size": "0.875rem", "lineHeight": "1.25rem", "fontWeight": "400", "family": "sans" },
      "body-xs": { "size": "0.75rem", "lineHeight": "1rem", "fontWeight": "400", "family": "sans" },
      "mono-l": { "size": "1rem", "lineHeight": "1.5rem", "fontWeight": "400", "family": "mono" },
      "mono-m": { "size": "1rem", "lineHeight": "1.5rem", "fontWeight": "400", "family": "mono" },
      "mono-s": { "size": "0.875rem", "lineHeight": "1.25rem", "fontWeight": "400", "family": "mono" }
    }
  },
  "spacing": {
    "scaleRem": {
      "1": 0.25, "2": 0.5, "3": 0.75, "4": 1, "5": 1.25, "6": 1.5,
      "8": 2, "10": 2.5, "12": 3, "16": 4, "20": 5, "24": 6
    },
    "sectionPadding": "px-4 py-16 md:px-10 md:py-24",
    "headerHeightPx": 72,
    "asideWidthPx": 400,
    "gridItemMinWidthPx": 355,
    "maxContentWidthPx": 1440
  },
  "radii": {
    "none": "0",
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem",
    "xl": "1rem",
    "2xl": "1rem",
    "3xl": "1rem",
    "pill": "9999px",
    "full": "9999px",
    "defaultImage": "0.5rem",
    "defaultButton": "0.5rem",
    "defaultCard": "0.5rem",
    "productCard": "0.75rem",
    "capNote": "xl/2xl/3xl all capped at 1rem — do not escalate"
  },
  "motion": {
    "durations": { "fast": "150ms", "base": "250ms", "slow": "400ms", "themeColor": "300ms", "aside": "200ms", "overlay": "400ms", "sectionReveal": "350ms" },
    "easings": {
      "sectionReveal": [0.22, 1, 0.36, 1]
    },
    "animations": {
      "fade-in": { "duration": "400ms", "easing": "ease-out" },
      "slide-up": { "duration": "500ms", "fromY": 12 },
      "theme-spin": { "duration": "400ms", "fromRotate": -90, "fromScale": 0.85 },
      "buttonHoverScale": 1.02,
      "imageHoverScale": 1.02
    },
    "respectReducedMotion": true
  },
  "themeRuntime": {
    "storageKey": "pawra-theme",
    "modes": ["light", "dark", "system"],
    "default": "system",
    "htmlClass": "dark",
    "bootScript": "THEME_BOOT_SCRIPT in app/lib/theme.js"
  },
  "components": {
    "button": {
      "variants": ["primary", "secondary", "ghost", "accent", "golden", "premium", "destructive"],
      "sizes": {
        "sm": { "height": "2.25rem", "paddingX": "1rem", "type": "body-s" },
        "md": { "height": "2.75rem", "paddingX": "1.5rem", "type": "body-m" },
        "lg": { "height": "3rem", "paddingX": "2rem", "type": "body-m" }
      },
      "radius": "md",
      "font": "sans semibold",
      "primary": "forest fill white label",
      "secondary": "chestnut outline",
      "golden": "Golden Honey fill near-black label"
    },
    "badge": {
      "types": ["new", "best-seller", "coming-soon", "walker-approved", "care-plan", "sale", "in-stock", "low-stock", "rx-required"],
      "shape": "rounded-md px-2.5 py-1 text-body-xs font-medium tracking-wide",
      "sale": "solid accent + accent-label"
    },
    "card": {
      "variants": ["product", "product-hero", "feature", "stat", "testimonial", "walker-program"],
      "base": "rounded-md bg-surface overflow-hidden"
    },
    "icon": {
      "strokeWidth": 1.75,
      "sizes": { "sm": 16, "md": 20, "lg": 24 },
      "names": ["cart", "search", "user", "heart", "paw", "walker", "gps", "check", "arrow-right", "menu", "close", "star", "plus", "minus", "shield", "leaf", "truck", "wifi", "chevron-down", "chevron-right", "chevron-left", "sun", "moon", "instagram", "tiktok", "facebook", "pinterest", "chat"]
    },
    "logo": {
      "component": "PawraLogo",
      "variants": ["primary", "light", "icon-only", "dark"],
      "mark": "abstract paw pad + toes + leaf accent",
      "headerHeights": { "mobile": 34, "desktop": 32 },
      "heroHeight": 28,
      "footerHeight": 28
    },
    "pattern": {
      "tile": "64x64",
      "rotateDeg": 12,
      "defaultOpacity": 0.12
    }
  },
  "layoutPatterns": {
    "hero": {
      "type": "full-bleed",
      "minHeight": { "mobile": "78vh", "desktop": "88vh" },
      "overlayLight": "from/70 via/40 to/20 of hero-overlay",
      "overlayDark": "from/85 via/60 to/40 of hero-overlay",
      "contents": ["brand logo light", "serif display headline", "one support sentence", "CTA group", "optional micro guarantee"],
      "forbiddenInFirstViewport": ["stats", "schedules", "promo chips", "floating badges", "address blocks", "secondary marketing"]
    },
    "announcementBar": {
      "bg": "action-primary",
      "fg": "action-primary-label",
      "storageKey": "pawra-announcement-closed"
    },
    "header": {
      "sticky": true,
      "heightPx": 72,
      "bg": "header/80 backdrop-blur-md",
      "scrollShadowLightOnly": true
    },
    "footer": {
      "bg": "footer",
      "fg": "footer-fg",
      "columns": ["brand+newsletter", "shop", "company", "support"],
      "copyright": "font-mono 12px opacity 60%"
    },
    "sectionReveal": {
      "from": { "opacity": 0, "y": 16 },
      "to": { "opacity": 1, "y": 0 },
      "duration": 0.35,
      "ease": [0.22, 1, 0.36, 1],
      "once": true
    }
  },
  "sourceFiles": {
    "cssTokens": "hydrogen-quickstart/app/styles/app.css",
    "tailwind": "hydrogen-quickstart/tailwind.config.ts",
    "baseLayer": "hydrogen-quickstart/app/styles/tailwind.css",
    "rawTokens": "hydrogen-quickstart/app/assets/tokens/pawra-tokens.json",
    "branding": "hydrogen-quickstart/app/lib/branding.js",
    "theme": "hydrogen-quickstart/app/lib/theme.js",
    "primaryButton": "hydrogen-quickstart/app/lib/primaryButton.js",
    "brandMark": "hydrogen-quickstart/app/components/ui/brandMark.jsx",
    "ui": "hydrogen-quickstart/app/components/ui/",
    "designSystemRoute": "hydrogen-quickstart/app/routes/design-system.jsx",
    "humanDoc": "DESIGN_LOCK.md"
  },
  "legacyNote": "Root src/ + tailwind.config.js uses an older ivory/emerald luxury palette — NOT canonical. Use Hydrogen Trust & Warmth tokens for all new work."
}
